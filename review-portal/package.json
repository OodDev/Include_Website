{
  "name": "include-review-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Password-gated change-request portal for the INCLUDE website (client-facing, Italian).",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
