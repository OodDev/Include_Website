# INCLUDE Website — environment variables
# Copy to .env.local (never commit .env.local). Names and descriptions only — no secrets in this file.

# ── Environment ────────────────────────────────────────────────────────────
# development | preview | production — drives noindex, robots and metadata behaviour
SITE_ENV=development

# Canonical production origin, e.g. https://example.org — all canonical URLs,
# sitemap, hreflang, JSON-LD and OG images derive from this. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Contact form (availability gate: form renders operational only when set) ──
# Default recipient mailbox for contact requests (owner-supplied, never assumed)
CONTACT_TO_EMAIL=
# Optional JSON map audience→recipient, e.g. {"company":"sme@example.org"}
CONTACT_ROUTING=
# smtp | brevo
MAIL_PROVIDER=
# Brevo API key (server-only)
BREVO_API_KEY=
BREVO_LIST_ID=
# Standard SMTP URL (e.g. EU provider)
SMTP_URL=

# ── Newsletter (availability gate; enables the newsletter card only when set) ──
NEWSLETTER_PROVIDER=

# ── Anti-spam (ALTCHA proof-of-work; self-hosted challenge) ──
# HMAC key used to sign and verify ALTCHA challenges — generate with: openssl rand -hex 24
ALTCHA_HMAC_KEY=

# ── Analytics (default none; enabled only with owner approval) ──
# none | plausible | matomo | ga4
ANALYTICS_PROVIDER=
PLAUSIBLE_DOMAIN=
GA_MEASUREMENT_ID=

# ── Search engine verification (optional meta tags) ──
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# ── CI / deployment only ────────────────────────────────────────────────────
# CI_COMMIT_SHA is set by CI; used for cache keys.
